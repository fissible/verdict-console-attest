{
  "name": "fissible/verdict-console-attest",
  "description": "Attest bridge for the Verdict Console: automated, dated chain-verification claims and gap traces on the console's evidence-integrity boundary.",
  "keywords": [
    "ai",
    "ai-agents",
    "attest",
    "audit",
    "human-in-the-loop",
    "laravel",
    "tamper-evident",
    "verification"
  ],
  "homepage": "https://github.com/fissible/verdict-console-attest",
  "license": "MIT",
  "authors": [
    {
      "name": "Allen McCabe",
      "email": "allenmccabe@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "fissible/attest-laravel": "^1.1",
    "fissible/verdict": "^0.18",
    "fissible/verdict-console": "^0.11",
    "illuminate/contracts": "^12.0||^13.0",
    "illuminate/support": "^12.0||^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^10.0||^11.0",
    "pestphp/pest": "^4.6",
    "pestphp/pest-plugin-laravel": "^4.1",
    "pestphp/pest-plugin-type-coverage": "^4.0",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Fissible\\VerdictConsoleAttest\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fissible\\VerdictConsoleAttest\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fissible\\VerdictConsoleAttest\\VerdictConsoleAttestServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "lint": [
      "vendor/bin/pint"
    ],
    "lint:check": [
      "vendor/bin/pint --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "test:types": [
      "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
